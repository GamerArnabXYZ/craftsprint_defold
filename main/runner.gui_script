function init(self)
    msg.post(".", "acquire_input_focus")
    
    self.player_node = gui.get_node("player")
    self.obstacle_node = gui.get_node("obstacle")
    
    self.player_base_y = 130
    self.player_y = self.player_base_y
    self.velocity_y = 0
    self.gravity = -1200
    self.is_grounded = true
    
    self.obstacle_x = 1000
    self.speed = 350
    self.score = 0
    self.game_over = false
end

function update(self, dt)
    if self.game_over then return end

    -- Jump Physics & Gravity
    if not self.is_grounded then
        self.velocity_y = self.velocity_y + self.gravity * dt
        self.player_y = self.player_y + self.velocity_y * dt
        
        if self.player_y <= self.player_base_y then
            self.player_y = self.player_base_y
            self.velocity_y = 0
            self.is_grounded = true
        end
        gui.set_position(self.player_node, vmath.vector3(150, self.player_y, 1))
    end

    -- Move Obstacle
    self.obstacle_x = self.obstacle_x - self.speed * dt
    if self.obstacle_x < -50 then
        self.obstacle_x = 1000 + math.random(0, 200)
        self.score = self.score + 1
        self.speed = self.speed + 10 -- Speed up slightly over time
    end
    gui.set_position(self.obstacle_node, vmath.vector3(self.obstacle_x, 125, 1))

    -- Simple AABB Collision Detection
    local player_pos = gui.get_position(self.player_node)
    local obstacle_pos = gui.get_position(self.obstacle_node)
    
    if math.abs(player_pos.x - obstacle_pos.x) < 40 and math.abs(player_pos.y - obstacle_pos.y) < 50 then
        self.game_over = true
        print("Game Over! Final Score: " .. self.score)
        -- Reset after 1 second on tap
    end
end

function on_input(self, action_id, action)
    if (action_id == hash("touch") or action_id == hash("jump")) and action.pressed then
        if self.game_over then
            -- Reset Game
            self.game_over = false
            self.score = 0
            self.speed = 350
            self.obstacle_x = 1000
        elseif self.is_grounded then
            self.velocity_y = 650
            self.is_grounded = false
        end
    end
end

function init(self)
    msg.post(".", "acquire_input_focus")
    
    self.player_base_y = 130
    self.player_y = self.player_base_y
    self.velocity_y = 0
    self.gravity = -1200
    self.is_grounded = true
    
    self.obstacle_x = 1000
    self.speed = 350
    self.score = 0
    self.game_over = false
end

function update(self, dt)
    if self.game_over then return end

    -- Gravity & Jump
    if not self.is_grounded then
        self.velocity_y = self.velocity_y + self.gravity * dt
        self.player_y = self.player_y + self.velocity_y * dt
        
        if self.player_y <= self.player_base_y then
            self.player_y = self.player_base_y
            self.velocity_y = 0
            self.is_grounded = true
        end
    end

    -- Move Obstacle
    self.obstacle_x = self.obstacle_x - self.speed * dt
    if self.obstacle_x < -50 then
        self.obstacle_x = 1000 + math.random(0, 200)
        self.score = self.score + 1
        self.speed = self.speed + 10
    end

    -- Collision
    if math.abs(150 - self.obstacle_x) < 40 and math.abs(self.player_y - 125) < 50 then
        self.game_over = true
        print("GAME OVER! Score: " .. self.score)
    end
end

function on_input(self, action_id, action)
    if (action_id == hash("touch") or action_id == hash("jump")) and action.pressed then
        if self.game_over then
            self.game_over = false
            self.score = 0
            self.speed = 350
            self.obstacle_x = 1000
        elseif self.is_grounded then
            self.velocity_y = 650
            self.is_grounded = false
        end
    end
end
